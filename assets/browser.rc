// Application icon and version info for Browser.exe.
#include <windows.h>

IDI_ICON1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "fanxcz"
            VALUE "FileDescription",  "Browser — консольный браузер для Windows"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Browser"
            VALUE "OriginalFilename", "Browser.exe"
            VALUE "ProductName",      "Browser"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
